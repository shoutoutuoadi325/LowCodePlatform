    },
    "connections": [
      {
        "source": "sensor1",
        "target": "controller1",
        "trigger_type": "motion_detected",
        "action": "turn_on_all",
        "parameters": {
          "brightness": 100
        }
      },
      {
        "source": "sensor2",
        "target": "controller2",
        "trigger_type": "motion_detected",
        "action": "turn_on_all",
        "parameters": {
          "brightness": 80
        }
      },
      {
        "source": "scheduler1",
        "target": "controller1",
        "trigger_type": "time_based",
        "action": "execute_schedule"
      }
    ],
    "automation_rules": [
      {
        "id": "rule1",
        "name": "人体感应自动开灯",
        "description": "检测到人体移动时自动开启灯光",
        "enabled": true,
        "conditions": [
          {
            "sensor": "sensor1",
            "property": "motion",
            "operator": "equals",
            "value": true
          }
        ],
        "actions": [
          {
            "controller": "controller1",
            "operation": "control_all",
            "parameters": {
              "action": "turn_on",
              "brightness": 100
            }
          }
        ]
      },
      {
        "id": "rule2",
        "name": "无人5分钟自动关灯",
        "description": "5分钟内未检测到人体移动时自动关闭灯光",
        "enabled": true,
        "conditions": [
          {
            "sensor": "sensor1",
            "property": "motion",
            "operator": "equals",
            "value": false,
            "duration_seconds": 300
          }
        ],
        "actions": [
          {
            "controller": "controller1",
            "operation": "control_all",
            "parameters": {
              "action": "turn_off"
            }
          }
        ]
      },
      {
        "id": "rule3",
        "name": "夜间模式",
        "description": "晚上18:00后开灯亮度降低到60%",
        "enabled": true,
        "conditions": [
          {
            "type": "time_range",
            "start_time": "18:00",
            "end_time": "23:59"
          },
          {
            "sensor": "sensor1",
            "property": "motion",
            "operator": "equals",
            "value": true
          }
        ],
        "actions": [
          {
            "controller": "controller1",
            "operation": "control_all",
            "parameters": {
              "action": "turn_on",
              "brightness": 60
            }
          }
        ]
      }
    ]
  }
}
