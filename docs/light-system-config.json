{
  "system": {
    "classes": {
      "Device": {
        "description": "所有IoT设备的基类（祖父类）",
        "type": "abstract",
        "attributes": {
          "id": "string",
          "deviceId": "string",
          "name": "string",
          "type": "string",
          "status": "string",
          "location": "string",
          "building": "string",
          "floor": "string",
          "room": "string",
          "lastUpdate": "string",
          "isOnline": "bool",
          "metadata": "object"
        },
        "operations": [
          "initialize()",
          "shutdown()",
          "get_status() -> string",
          "update_location(location: object)",
          "ping() -> bool"
        ]
      },
      "Actuator": {
        "description": "执行器设备父类，继承自Device",
        "type": "abstract",
        "extends": "Device",
        "attributes": {
          "power": "string",
          "powerConsumption": "float",
          "isControllable": "bool"
        },
        "operations": [
          "turn_on()",
          "turn_off()",
          "toggle()",
          "get_power_state() -> string",
          "get_power_consumption() -> float"
        ]
      },
      "Sensor": {
        "description": "传感器设备父类，继承自Device",
        "type": "abstract",
        "extends": "Device",
        "attributes": {
          "sensitivity": "int",
          "samplingRate": "int",
          "lastTriggered": "string",
          "calibrationDate": "string"
        },
        "operations": [
          "read_value() -> object",
          "set_sensitivity(level: int)",
          "calibrate()",
          "reset()",
          "get_history(duration: int) -> array"
        ]
      },
      "Light": {
        "description": "智能灯光设备，继承自Actuator",
        "extends": "Actuator",
        "attributes": {
          "brightness": "int",
          "color": "string",
          "colorTemperature": "int",
          "isDimmable": "bool",
          "supportsColor": "bool"
        },
        "operations": [
          "set_brightness(level: int)",
          "set_color(color: string)",
          "set_color_temperature(temp: int)",
          "get_state() -> object"
        ]
      },
      "MotionSensor": {
        "description": "人体感应传感器，继承自Sensor",
        "extends": "Sensor",
        "attributes": {
          "motion": "bool",
          "detectionRange": "float",
          "detectionAngle": "int"
        },
        "operations": [
          "detect_motion() -> bool",
          "get_detection_zone() -> object"
        ]
      },
      "Controller": {
        "description": "设备控制器基类",
        "type": "abstract",
        "attributes": {
          "id": "string",
          "name": "string",
          "controlledDevices": "array",
          "isMaster": "bool",
          "strategy": "string"
        },
        "operations": [
          "add_device(device_id: string)",
          "remove_device(device_id: string)",
          "control_all(action: string, parameters: object)",
          "get_all_states() -> array"
        ]
      },
      "LightController": {
        "description": "灯光控制器，继承自Controller",
        "extends": "Controller",
        "attributes": {
          "controlled_lights": "array",
          "groupBrightness": "int",
          "groupColor": "string"
        },
        "operations": [
          "add_light(light_id: string)",
          "remove_light(light_id: string)",
          "set_group_brightness(level: int)",
          "set_group_color(color: string)"
        ]
      },
      "Scheduler": {
        "description": "调度器基类",
        "type": "abstract",
        "attributes": {
          "id": "string",
          "name": "string",
          "schedules": "array",
          "isActive": "bool",
          "timezone": "string"
        },
        "operations": [
          "add_schedule(schedule: object)",
          "remove_schedule(schedule_id: string)",
          "enable()",
          "disable()",
          "execute_schedule(schedule_id: string)"
        ]
      },
      "LightScheduler": {
        "description": "灯光定时调度器，继承自Scheduler",
        "extends": "Scheduler",
        "attributes": {
          "targetController": "string",
          "defaultBrightness": "int"
        },
        "operations": [
          "set_target_controller(controller_id: string)"
        ]
      }
    },
    "class_hierarchy": {
      "Device": {
        "children": ["Actuator", "Sensor"]
      },
      "Actuator": {
        "parent": "Device",
        "children": ["Light"]
      },
      "Sensor": {
        "parent": "Device",
        "children": ["MotionSensor"]
      },
      "Light": {
        "parent": "Actuator",
        "grandparent": "Device"
      },
      "MotionSensor": {
        "parent": "Sensor",
        "grandparent": "Device"
      },
      "Controller": {
        "children": ["LightController"]
      },
      "LightController": {
        "parent": "Controller"
      },
      "Scheduler": {
        "children": ["LightScheduler"]
      },
      "LightScheduler": {
        "parent": "Scheduler"
      }
    },
